{$DOMAIN} {
    encode zstd gzip
    log {
        output stdout
        format filter {
            request>uri query {
                delete code
                delete state
                delete session_state
                delete id_token
                delete error_description
            }
            wrap json
        }
    }
    header {
        Strict-Transport-Security "max-age=15552000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy api:3000
    }
    handle {
        reverse_proxy web:8080
    }
}
